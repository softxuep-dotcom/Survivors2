{
  "name": "horde-breaker",
  "version": "0.3.2",
  "description": "Horde Spark - elemental survivors-like for CrazyGames",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8081",
    "start": "vite --host 0.0.0.0 --port 8081",
    "build": "vite build && node tools/prepare-sites.mjs",
    "check:i18n": "node tools/check-locales.mjs",
    "check:synergy": "node tools/element-synergy-contract.mjs",
    "check:props": "node tools/prop-system-contract.mjs",
    "check:skills": "node tools/skill-system-contract.mjs",
    "balance": "node tools/balance-sim.mjs",
    "check:crazygames": "node tools/crazygames-contract.mjs",
    "prepare:crazygames": "npm run build && node tools/crazygames-upload.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 8081"
  },
  "dependencies": {
    "phaser": "^4.2.0"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  }
}
